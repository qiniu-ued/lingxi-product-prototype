{
  "name": "lingxi-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/protocol",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run build -w @lingxi/protocol && concurrently --kill-others --names server,web \"npm run dev -w @lingxi/server\" \"npm run dev -w @lingxi/web\"",
    "build": "npm run build --workspaces",
    "start": "npm run start -w @lingxi/server",
    "typecheck": "npm run build -w @lingxi/protocol && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tooling.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build -w @lingxi/protocol && vitest run",
    "test:coverage": "npm run test -- --coverage",
    "test:e2e": "npm run build -w @lingxi/protocol && playwright test",
    "smoke": "node scripts/smoke.mjs",
    "release:pack": "npm run build && node scripts/package.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run smoke",
    "prototype": "python3 -m http.server 8080 --directory dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
